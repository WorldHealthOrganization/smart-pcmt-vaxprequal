Alias: $vaccinetype = http://smart.who.int/pcmt-vaxprequal/CodeSystem/PreQualVaccineType
CodeSystem: PreQualVaccineType
Title : "WHO PreQualificaiton Vaccine VaccineTypes"
Description: "WHO PreQualificaiton Vaccine VaccineTypes"

* #BCG "BCG"
* #DT "Diphtheria and tetanus vaccine (adsorbed)"
* #DTwP "Diphtheria, tetanus and (whole cell) pertussis vaccine (adsorbed)"
* #HepA "Hepatitis A vaccine (inactivated)"
* #HepB "Hepatitis B vaccine (recombinant)"
* #JE "Japanese encephalitis vaccine (live, attenuated) for human use"
* #LARV "Rotavirus vaccine (live attenuated) (oral)"
* #M "Measles vaccine (live, attenuated)"
* #MMR "Measles, mumps, rubella combined vaccine (live, attenuated)"
* #MR "Measles, rubella combined vaccine (live, attenuated)"
* #Malaria "Recombinant malaria vaccine"
* #TDV "Dengue tetravalent vaccine (live, attenuated)"
* #TT "Tetanus vaccine (adsorbed)"
* #YF "Yellow fever vaccine (live attenuated)"
* #bOPV "Poliomyelitis vaccines (bivalent live, oral, innactivated, type 1, 3)"
* #dT "Diphtheria and tetanus vaccine (adsorbed, reduced diphtheria antigen content)"
* #tOPV "Poliomyelitis vaccines (trivalent live, oral, innactivated, type 1,2, 3)"
