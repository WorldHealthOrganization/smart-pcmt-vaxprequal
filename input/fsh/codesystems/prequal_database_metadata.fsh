Alias: $prequal-metadata = http://smart.who.int/pcmt-vaxprequal/CodeSystem/PreQualDatabaseMetadata
CodeSystem: PreQualDatabaseMetadata
Title: "WHO PreQualification Database Metadata"
Description: "Coded metadata values from the WHO PreQualification database"
* ^experimental = true
* ^caseSensitive = true
* ^name = "PreQualDatabaseMetadata"
* ^status = #active

// ProductType
* #FinishedVaccineProduct "Finished Vaccine Product"

// AssessmentProcedure
* #EUL "EUL"
* #PrequalificationAbridged "Prequalification - Abridged"
* #PrequalificationStandard "Prequalification - Standard"

// Status
* #Acceptable "Acceptable"
* #CancelledAssessment "Cancelled: Assessment"
* #DecisionPhase "Decision Phase"
* #Prequalified "Prequalified"
* #RejectedScreening "Rejected: Screening"
* #UnderAssessment "Under Assessment"
* #UnderScreening "Under Screening"
* #WithdrawnWasAccepted "Withdrawn: Was Accepted"
* #WithdrawnWasPrequalified "Withdrawn: Was Prequalified"

// PharmaceuticalForm
* #LiquidActivecomponenttobemixedwithsecondcomponentbeforeuse "Liquid: Active component to be mixed with second component before use"
* #LiquidReadytouse "Liquid: Ready to use"
* #Lyophilisedactivecomponenttobereconstitutedwithexcipientdiluentbeforeuse "Lyophilised active component to be reconstituted with excipient diluent before use"
* #Lyophilisedactivecomponenttobereconstitutedwithliquidactivecomponentbeforeuse "Lyophilised active component to be reconstituted with liquid active component before use"

// RouteOfAdministration
* #Intradermal "Intradermal"
* #Intramuscular "Intramuscular"
* #Intramuscularordeepsubcutaneous "Intramuscular or deep subcutaneous"
* #Intramuscularorsubcutaneous "Intramuscular or subcutaneous"
* #Intranasal "Intranasal"
* #Oral "Oral"
* #Subcutaneous "Subcutaneous"

// PackagingType
* #Secondary "Secondary"
* #ShippingContainer "Shipping Container"
* #Tertiary "Tertiary"

// ComponentPacked
* #ActiveVaccine "Active (Vaccine)"
* #ActiveVaccineandDiluent "Active (Vaccine) and Diluent"
* #Diluent "Diluent"

// DocumentType
* #Photo "Photo"
* #PhotoMainImage "Photo-Main Image"
* #ProductInsert "Product Insert"
* #VSPAR "VSPAR"
* #VaccineGeneralDocument "Vaccine General Document"

// SiteActivity
* #FVPManufacture "FVP Manufacture"

// SiteStatus
* #Accepted "Accepted"

// IngredientType
* #VxFVP "Vx FVP"

// ProductComponentType
* #Active "Active"

